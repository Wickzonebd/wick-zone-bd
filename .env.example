# Public Supabase browser configuration. A publishable key is safe for browser use.
NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_REPLACE_ME

# Server-only payment credentials are intentionally absent until a real gateway is configured.
# Never prefix payment secrets or a Supabase service-role key with NEXT_PUBLIC_.
PAYMENT_GATEWAY=not_configured
PAYMENT_API_BASE_URL=
PAYMENT_MERCHANT_ID=
PAYMENT_WEBHOOK_SECRET=
